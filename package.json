{
  "name": "zippo",
  "version": "1.0.0",
  "private": true,
  "description": "Zippo — Everyday Quick Commerce Delivery Super App",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix admin && npm install --prefix partner",
    "build": "npm run build --prefix frontend && npm run build --prefix admin && npm run build --prefix partner",
    "start": "node backend/server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin",
    "dev:partner": "npm run dev --prefix partner",
    "mobile": "npm start --prefix mobile",
    "mobile:android": "npm run android --prefix mobile",
    "mobile:ios": "npm run ios --prefix mobile",
    "delivery": "npm start --prefix delivery",
    "delivery:web": "npm run web --prefix delivery",
    "delivery:android": "npm run android --prefix delivery",
    "delivery:ios": "npm run ios --prefix delivery"
  },
  "keywords": [
    "delivery",
    "vegetables",
    "ecommerce",
    "react",
    "express",
    "socketio",
    "mongodb"
  ],
  "author": "Zippo",
  "license": "ISC"
}

