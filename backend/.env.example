# Copy this file to .env and fill in real values.
# The server works fine without these â€” it just skips sending
# email/SMS and logs a note in the console instead.

PORT=4000

# --- MongoDB Database URI (Local or MongoDB Atlas) ---
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/chop_and_drop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/chop_and_drop

# --- Admin dashboard password (required to view/manage orders at /admin) ---
ADMIN_PASSWORD=changeme

# --- Email (any SMTP account works â€” Gmail App Password, SendGrid, Zoho, etc.) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-business@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Easy Foods <your-business@gmail.com>"

# --- SMS (Twilio account â€” console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Customer login/register (JWT signing secret â€” use a long random string) ---
JWT_SECRET=replace-with-a-long-random-string

